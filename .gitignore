# Dependencies (each project also carries its own .gitignore)
node_modules/

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
*.local

# Logs and temporary output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
test-results/
playwright-report/
blob-report/

# Editor / OS metadata
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
