# PharmaStock Backend — Environment Configuration
# Copy this file to .env and fill in your real values. Never commit .env.

# ---- Required -------------------------------------------------------------

# Port for the Express server
PORT=5000

# MongoDB connection string. A REPLICA SET IS REQUIRED: purchases, sales,
# refunds and adjustments run inside multi-document transactions, which a
# standalone mongod cannot execute (the API then answers 503
# TRANSACTIONS_REQUIRED instead of writing inconsistent stock).
MONGODB_URI=mongodb://127.0.0.1:27017/pharma_stock_management?replicaSet=rs0

# MongoDB Atlas instead: replace USERNAME, PASSWORD and CLUSTER, and keep
# retryWrites plus w=majority so transactions are enabled.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/pharma_stock_management?retryWrites=true&w=majority

# JWT signing secret. Must be at least 32 characters; the API refuses to sign or
# verify a token with anything shorter, or with the placeholder below.
JWT_SECRET=replace_with_at_least_32_random_characters

# Comma-separated browser origins allowed by CORS. An origin outside this list
# is rejected with 403 CORS_DENIED.
CLIENT_ORIGIN=http://localhost:5173

# ---- Optional -------------------------------------------------------------

# Token lifetime (any jsonwebtoken duration string).
JWT_EXPIRES_IN=8h

# Error-detail behaviour: 5xx responses return a generic message when this is
# exactly "production".
NODE_ENV=development

# Global rate limit per IP per 15 minutes.
RATE_LIMIT_MAX=1000

# Failed-login limit per IP per 15 minutes. Successful logins do not count.
LOGIN_RATE_LIMIT_MAX=10

# Express `trust proxy` setting, off unless set. "true" trusts one hop, "false"
# disables it, or pass a comma-separated list of trusted proxies. Leave unset
# when the API is not behind a proxy; trusting forwarded headers blindly lets a
# client spoof X-Forwarded-For and evade the per-IP rate limits.
# TRUST_PROXY=true

# ---- Tests only -----------------------------------------------------------

# The transaction integration suite runs only when this is "true" and both
# MONGODB_URI and SEED_PASSWORD are set. Point MONGODB_URI at a disposable
# database. TEST_* values override which seeded account the suite signs in as.
# RUN_TRANSACTION_TESTS=true
# TEST_ADMIN_EMAIL=admin@pharmastock.in
# TEST_ADMIN_PASSWORD=replace_with_a_local_test_password
# TEST_VIEWER_EMAIL=sateesh@pharmastock.in

# ---- Development seed only ------------------------------------------------

# The seed is destructive. It refuses to run unless SEED_CONFIRM is exactly
# RESET or --force is passed, and there is no default password anywhere in the
# repository. Never point it at a database you care about.
SEED_CONFIRM=RESET
SEED_PASSWORD=replace_with_a_local_seed_password

# Optional seed controls. SEED_DAY anchors every derived date (default: today).
# SEED_RANDOM_SEED makes the generated dataset reproducible (default: 20260930).
# SEED_DAY=2026-10-01
# SEED_RANDOM_SEED=20260930
